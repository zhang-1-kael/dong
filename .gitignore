# ── macOS ──────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes

# ── 编译与打包产物 ──────────────────────────────────────
build/
dist/
build_scene/
*.dmg
*.app
*.xcarchive
DerivedData/

# ── 依赖与虚拟环境 ──────────────────────────────────────
.venv/
venv/
node_modules/
# 只忽略 vendor/ 里的其它内容，链接解析组件 yt-dlp_macos 必须进版本库（否则干净打包会丢）
vendor/*
!vendor/yt-dlp_macos

# ── 素材（体积大 / 版权受限，不入库）────────────────────
# presets/ 是内置壁纸，bili/ 是从平台抓下来的原始素材。
# 如果你要自己打包带素材的版本，在本地保留目录、只在打包时使用即可。
presets/
bili/
shots/

# ── 本地配置与密钥 ──────────────────────────────────────
*.local
config.local.*
.env
.env.*
!.env.example
